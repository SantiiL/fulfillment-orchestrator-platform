{
  "activationGates": [
    "FOP-AGENTIC-003 final human approval",
    "external runner installation",
    "external runtime-contract manifest regeneration",
    "installed manifest verification pass"
  ],
  "authoritativeExternalRuntime": {
    "runnerEntrypoint": "~/.openclaw/scripts/fop-deterministic-runner",
    "runtimeConfigPath": "~/.openclaw/config/fulfillment-orchestrator-platform/deterministic-runner.json",
    "runtimeContractManifest": "~/.openclaw/trust/fulfillment-orchestrator-platform/runtime-contracts.sha256",
