    "requiredHostPrimitive": "kernel-enforced child write confinement before exec",
    "writableRoots": [
      "validated task worktree",
      "per-attempt runtime artifact directory"
    ]
  },
  "runtimeConfigSchema": {
    "requiredAbsolutePaths": [
      "openClawExecutable",
      "runtimeContractVerifier",
      "runRoot",
      "lockRoot"
    ],
    "schemaVersion": "fop-deterministic-runner-runtime/v1"
  },
  "schemaVersion": "fop-runtime-requirements/v1"
}
